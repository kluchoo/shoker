{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Shoker: Install & Launch (device/emulator)",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/scripts/android-run.ps1\"",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Shoker: Desktop server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
